# Copy this file to `.env` and fill in your own values.
# docker compose reads it automatically; never commit the real `.env`.

# Kubeflow (Dex) endpoint and account
KUBEFLOW_HOST=http://<kubeflow-host>:<port>
KUBEFLOW_USERNAME=<your-kubeflow-username>
KUBEFLOW_PASSWORD=<your-kubeflow-password>

# MinIO object storage used for uploaded datasets
MINIO_HOST=<minio-host>:9000
MINIO_ROOT_USER=<minio-user>
MINIO_ROOT_PASSWORD=<minio-password>
